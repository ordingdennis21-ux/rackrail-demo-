# RackRail Solution – Sicherheits- und Auslieferungsregeln (Apache / IONOS)
# Auf GitHub Pages wird diese Datei ignoriert; auf IONOS ist sie aktiv.

# 1) Immer auf HTTPS umleiten
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# 2) Sicherheits-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-o1e+QmnZg2Lobj83buxmHproWnyhn6PQBnBWHdjquIw='; img-src 'self' data:; font-src 'self'; manifest-src 'self'; media-src 'self'; connect-src 'self'; form-action 'self' mailto:; base-uri 'none'; object-src 'none'; upgrade-insecure-requests; frame-ancestors 'none'"
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# 3) Versteckte und sensible Dateien sperren
<FilesMatch "^\.(ht|git)">
  Require all denied
</FilesMatch>

# 4) Verzeichnislisting aus
Options -Indexes
